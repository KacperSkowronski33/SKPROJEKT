  <property name="styleSheet">
   <string notr="true">/* --- GŁÓWNE TŁO --- */
QMainWindow, QWidget#centralWidget {
    background-color: #2b2b2b;
    color: #f0f0f0;
}

/* --- PASEK STANU (QStatusBar) --- */
QMenuBar {
    background-color: #202020;
    border: none;
}

/* --- 2. STYLIZACJA SAMEGO PRZYCISKU (QAction) --- */
QMenuBar#menuBar::item {
    background-color: #1976d2; /* Niebieski akcent */
    color: white;
    padding: 6px 12px;
    margin: 2px 4px; 
    border-radius: 4px;
    font-weight: bold;
}

QMenuBar#menuBar::item:selected {
    background-color: #2196f3; 
}

QMenuBar#menuBar::item:pressed {
    background-color: #0d47a1;
}

/* --- LEWY PANEL (Kontenery) --- */
QGroupBox {
    background-color: #333333;
    border: 1px solid #555555;
    border-radius: 6px;
    margin-top: 22px; /* Miejsce na tytuł */
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 0 5px;
    color: #4da6ff; /* Niebieski kolor tytułów */
    background-color: transparent;
}

/* --- POLA EDYCJI I ETYKIETY --- */

QLabel {
    color: #dddddd;
    background-color: transparent; /* Żeby nie miały tła rodzica */
    border: none;
}


QDoubleSpinBox, QSpinBox, QComboBox {
    background-color: #454545;
    border: 1px solid #666666;
    border-radius: 3px;
    padding: 4px;
    color: #ffffff;
    selection-background-color: #4da6ff;
}

QDoubleSpinBox:hover, QSpinBox:hover, QComboBox:hover {
    border: 1px solid #4da6ff;
}

/* --- PRZYCISKI (Dół ekranu) --- */
QPushButton {
    background-color: #404040;
    border: 1px solid #555555;
    border-radius: 4px;
    color: white;
    padding: 6px 12px;
    min-height: 25px;
}

QPushButton:hover {
    background-color: #505050;
    border: 1px solid #4da6ff;
}

QPushButton:pressed {
    background-color: #2a2a2a;
}

/* Specjalne kolory dla ważnych przycisków (po ObjectName) */
QPushButton#btnStart {
    background-color: #2e7d32; /* Zielony */
    border-color: #4caf50;
}
QPushButton#btnStart:hover { background-color: #388e3c; }

QPushButton#btnStop {
    background-color: #c62828; /* Czerwony */
    border-color: #ef5350;
}
QPushButton#btnStop:hover { background-color: #d32f2f; }

/* --- Pasek Stanu --- */
QStatusBar {
    background-color: #202020;
    color: #aaaaaa;
    border-top: 1px solid #444;
}

/* --- WYKRESY (QCustomPlot) --- */
/* Ważne: QCustomPlot rysuje własne tło w C++. 
   Ustawiamy tu border, żeby widać było granice widgetu. */
QCustomPlot {
    border: 1px solid #555555;
    border-radius: 4px;
    background-color: #1e1e1e; 
}</string>
