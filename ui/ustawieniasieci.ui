  <property name="styleSheet">
   <string notr="true">/* --- GŁÓWNE TŁO --- */
QDialog {
    background-color: #2b2b2b;
    color: #f0f0f0;
}

/* --- KONTENERY (Grupy) --- */
QGroupBox {
    background-color: #333333;
    border: 1px solid #555555;
    border-radius: 6px;
    margin-top: 22px; 
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 0 5px;
    color: #4da6ff; 
    background-color: transparent;
}

/* --- ETYKIETY I OPCJE (Radio) --- */
QLabel {
    color: #dddddd;
    background-color: transparent; 
    border: none;
}

/* --- QRadioButton - Tekst --- */
QRadioButton {
    color: #dddddd;
    background-color: transparent;
}

/* --- QRadioButton - Kółeczko (Niezaznaczone) --- */
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border-radius: 7px; /* połowa szerokości/wysokości = idealne koło */
    border: 2px solid #666666;
    background-color: #454545;
}

/* --- QRadioButton - Kółeczko po najechaniu myszką --- */
QRadioButton::indicator:hover {
    border: 2px solid #4da6ff;
}

/* --- QRadioButton - Kółeczko (Zaznaczone) --- */
QRadioButton::indicator:checked {
    background-color: #4da6ff;
    border: 2px solid #dddddd;
}

/* --- POLA WPISYWANIA (IP i Port) --- */
QLineEdit, QSpinBox {
    background-color: #454545;
    border: 1px solid #666666;
    border-radius: 3px;
    padding: 4px;
    color: #ffffff;
    selection-background-color: #4da6ff;
}

QLineEdit:hover, QSpinBox:hover {
    border: 1px solid #4da6ff;
}

/* --- PRZYCISKI --- */
QPushButton {
    background-color: #404040;
    border: 1px solid #555555;
    border-radius: 4px;
    color: white;
    padding: 6px 12px;
    min-height: 25px;
}

QPushButton:hover {
    background-color: #505050;
    border: 1px solid #4da6ff;
}

QPushButton:pressed {
    background-color: #2a2a2a;
}

/* --- PRZYCISK POŁĄCZ (Niebieski Akcent) --- */

QPushButton#btnPolacz {
    background-color: #1976d2; 
    border-color: #2196f3;
    font-weight: bold;
}

QPushButton#btnPolacz:hover { 
    background-color: #2196f3; 
    border-color: #4da6ff;
}

QPushButton#btnPolacz:pressed {
    background-color: #0d47a1;
}</string>
